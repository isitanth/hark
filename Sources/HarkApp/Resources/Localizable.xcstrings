    "settings.model.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded from Hugging Face and verified against a pinned checksum. Larger models are more accurate in French and slower."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargés depuis Hugging Face et vérifiés par somme de contrôle épinglée. Les grands modèles sont plus précis en français et plus lents."
          }
        }
      }
    },
    "settings.model.inUse": {
      "extractionState": "manual",
