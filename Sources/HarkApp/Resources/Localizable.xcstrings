          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "settings.model.coreML": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Neural Engine (Core ML)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le Neural Engine (Core ML)"
          }
        }
      }
    },
    "settings.model.coreML.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off is faster for dictation: Core ML must process a full 30-second window, so it cannot skip the silence that makes short clips cheap. On draws less power, at the cost of an extra download per model (163 MB to 1.2 GB). Turning it off deletes the encoders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé est plus rapide pour la dictée : Core ML traite toujours une fenêtre complète de 30 secondes et ne peut pas ignorer le silence qui rend les clips courts rapides. Activé consomme moins d’énergie, au prix d’un téléchargement supplémentaire par modèle (de 163 Mo à 1,2 Go). Le désactiver supprime les encodeurs."
          }
        }
      }
    },
    "settings.model.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
