      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see which text field has focus, and to type your words into it. Without it, dictated text is only copied to the clipboard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour savoir quel champ de texte est actif, et y saisir vos mots. Sans elle, le texte dicté est seulement copié dans le presse-papiers."
          }
