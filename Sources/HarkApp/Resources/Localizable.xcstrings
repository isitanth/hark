    "settings.general.partialTranscript.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reads the last seconds with a second Small model while you speak. Uses more memory and energy. The text inserted is still the full transcription."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit les dernières secondes avec un second modèle Small pendant que vous parlez. Utilise davantage de mémoire et d’énergie. Le texte inséré reste la transcription complète."
          }
        }
      }
    },
    "settings.general.partialTranscript.needsSmall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs the Small model. Download it in the Model tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite le modèle Small. Téléchargez-le dans l’onglet Modèle."
          }
        }
      }
    },
    "settings.general.lowerOtherAudio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower other audio while recording"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisser le son des autres apps pendant l’enregistrement"
          }
        }
