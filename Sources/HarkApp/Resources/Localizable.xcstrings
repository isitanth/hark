    "permission.accessibility.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Accessibility: dictated text is only copied to the clipboard. Paste it with ⌘V."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans l’accessibilité, le texte dicté est seulement copié dans le presse-papiers. Collez-le avec ⌘V."
          }
        }
      }
    },
    "permission.microphone.missing": {
