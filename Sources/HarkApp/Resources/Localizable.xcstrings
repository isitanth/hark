    "settings.general.dictation.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text goes into the field that has focus, the way chosen above. With the fallback off, text that cannot be inserted is discarded rather than copied, and the log says so. The notification tells you when text has landed on the clipboard, and shows its first words."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte est saisi dans le champ actif, de la façon choisie ci-dessus. Si le repli est désactivé, un texte qui ne peut pas être inséré est abandonné au lieu d’être copié, et le journal l’indique. La notification signale les textes arrivés dans le presse-papiers et en montre les premiers mots."
          }
        }
      }
    },
