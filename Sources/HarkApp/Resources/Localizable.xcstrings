      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection costs an extra pass over every utterance. Pick a language if you dictate in only one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection ajoute une passe à chaque énoncé. Choisissez une langue si vous ne dictez que dans celle-ci."
          }
        }
      }
    },
