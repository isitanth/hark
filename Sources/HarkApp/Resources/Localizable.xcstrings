    "settings.general.lowerOtherAudio.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the output volume down while Hark listens, then back up. If you change the volume meanwhile, Hark leaves it as you set it. Not when you dictate through a Bluetooth headset’s microphone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse le volume de sortie pendant que Hark écoute, puis le rétablit. Si vous modifiez le volume entre-temps, Hark le laisse tel que vous l’avez réglé. Sauf si vous dictez avec le micro d’un casque Bluetooth."
          }
        }
      }
    },
