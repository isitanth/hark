    "settings.general.trigger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation shortcut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourci de dictée"
          }
        }
      }
    },
    "settings.general.triggerHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press to start, press again to stop. Hold it instead, and dictation stops when you let go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour démarrer, appuyez de nouveau pour arrêter. Si vous la maintenez, la dictée s’arrête au relâchement."
          }
        }
      }
    },
    "settings.model.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
